<?xml version="1.0" encoding="utf-8"?>
<!-- JUONG Glass - Top Pills Background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Apple tvOS bright focus with subtle cyan border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F0F8FF" />
            <stroke
                android:width="2dp"
                android:color="@color/juong_accent_cyan" />
            <corners android:radius="@dimen/juong_radius_pill" />
        </shape>
    </item>
    <!-- Activated / Active mode -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/juong_surface_glass_active" />
            <stroke
                android:width="1.5dp"
                android:color="@color/juong_accent_cyan" />
            <corners android:radius="@dimen/juong_radius_pill" />
        </shape>
    </item>
    <!-- Default glass state: translucent surface with subtle frosted border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2A243346"
                android:endColor="#18182230" />
            <stroke
                android:width="1dp"
                android:color="@color/juong_border_glass" />
            <corners android:radius="@dimen/juong_radius_pill" />
        </shape>
    </item>
</selector>
