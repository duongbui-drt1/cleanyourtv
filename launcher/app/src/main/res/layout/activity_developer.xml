<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/juong_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/juong_margin_screen_h"
        android:paddingEnd="@dimen/juong_margin_screen_h"
        android:paddingTop="@dimen/juong_margin_screen_v"
        android:paddingBottom="@dimen/juong_margin_screen_v">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/jtv_performance_manager"
                android:textColor="@color/juong_text_primary"
                android:textSize="26sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/btnBack"
                style="@style/TopButton"
                android:text="← Đóng"
                android:focusable="true" />
        </LinearLayout>

        <!-- Diagnostics Cards Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Quick Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/btnCleanRam"
                        style="@style/TopButton"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="12dp"
                        android:text="⚡ Dọn RAM Tức Thì"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnLaunchSmartTube4K"
                        style="@style/TopButton"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="📺 Mở SmartTube 4K"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnDisplaySettings"
                        style="@style/TopButton"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="🖥 Cài đặt Màn hình"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnSysDevOptions"
                        style="@style/TopButton"
                        android:layout_width="wrap_content"
                        android:text="🛠 Nhà phát triển"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeviceSpecs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tile_bg"
                    android:padding="20dp"
                    android:textColor="@color/juong_text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@string/font_body"
                    android:layout_marginBottom="16dp"
                    android:focusable="true" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
