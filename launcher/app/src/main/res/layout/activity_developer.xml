<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/juong_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/juong_margin_screen_h"
        android:paddingEnd="@dimen/juong_margin_screen_h"
        android:paddingTop="@dimen/juong_margin_screen_v"
        android:paddingBottom="@dimen/juong_margin_screen_v">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/developer_mode"
                android:textColor="@color/juong_text_primary"
                android:textSize="28sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/btnBack"
                style="@style/TopButton"
                android:text="Back"
                android:focusable="true" />
        </LinearLayout>

        <!-- Diagnostics Cards Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeviceSpecs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tile_bg"
                    android:padding="20dp"
                    android:textColor="@color/juong_text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@string/font_body"
                    android:layout_marginBottom="16dp"
                    android:focusable="true" />

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSysDevOptions"
                        style="@style/TopButton"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="16dp"
                        android:text="Open System Dev Settings"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnReloadTheme"
                        style="@style/TopButton"
                        android:layout_width="wrap_content"
                        android:text="Reload JUONG Theme"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
